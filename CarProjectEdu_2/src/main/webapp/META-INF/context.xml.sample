<?xml version="1.0" encoding="UTF-8"?>
<!--
 ================================================================================
   context.xml.sample  -  DB 커넥션풀 설정 견본

   [사용법]
     1. 이 파일을 같은 폴더에 context.xml 이라는 이름으로 복사한다
     2. username / password 를 본인 MySQL 계정으로 바꾼다
     3. 톰캣을 재시작한다

   [왜 견본을 따로 두는가]
     context.xml 에는 DB 계정과 비밀번호가 들어간다.
     이 파일이 git 저장소나 배포본에 들어가면 DB 접속 정보가 그대로 유출된다.
     그래서 context.xml 은 .gitignore 로 제외하고, 견본만 공유한다.

   [실무에서는]
     계정/비밀번호를 파일에 적지 않고 서버 환경변수나
     비밀정보 관리 서비스(AWS Secrets Manager, Vault 등)에서 주입한다.

   [주의] root 계정을 쓰지 말 것
     root 는 모든 DB를 삭제할 수 있는 최고 권한 계정이다.
     애플리케이션 전용 계정을 만들어 이 프로젝트의 DB에만 권한을 주는 것이 원칙이다.

       create user 'carapp'@'localhost' identified by '충분히_긴_비밀번호';
       grant select, insert, update, delete on rentcar_db.* to 'carapp'@'localhost';
       flush privileges;
 ================================================================================
-->
<Context>

	<!-- Tomcat JNDI 커넥션풀 설정 (MySQL 8 기준)

	     DAO 에서는 util.DBCPUtil 이 아래 이름으로 이 자원을 찾는다.
	         envContext.lookup("jdbc/jspbeginner")
	     따라서 name 값을 바꾸면 DBCPUtil 도 함께 바꿔야 한다.
	-->
	<Resource
		name="jdbc/jspbeginner"
		auth="Container"
		type="javax.sql.DataSource"
		driverClassName="com.mysql.cj.jdbc.Driver"

		username="여기에_DB계정"
		password="여기에_DB비밀번호"

		maxTotal="50"
		maxIdle="10"
		maxWaitMillis="10000"

		testOnBorrow="true"
		validationQuery="select 1"

		url="jdbc:mysql://localhost:3306/rentcar_db?serverTimezone=Asia/Seoul&amp;characterEncoding=UTF-8&amp;allowPublicKeyRetrieval=true&amp;useSSL=false"
	/>

	<!--
	 [추가된 설정 설명]

	   maxWaitMillis="10000"
	     - 커넥션이 없을 때 최대 10초만 기다리고 예외를 던진다.
	     - 기존 설정은 -1(무한 대기)이었다. 커넥션이 새는 코드가 하나라도 있으면
	       요청이 영원히 멈춘 채 쌓여 서버 전체가 응답하지 않게 된다.
	       실무에서는 반드시 유한한 값으로 둔다.

	   testOnBorrow="true" + validationQuery="select 1"
	     - 풀에서 커넥션을 꺼낼 때 살아 있는지 확인한다.
	     - MySQL은 오래 쉰 연결을 끊는데(기본 8시간),
	       이 설정이 없으면 아침 첫 요청에서 "Communications link failure" 가 난다.
	-->

</Context>
