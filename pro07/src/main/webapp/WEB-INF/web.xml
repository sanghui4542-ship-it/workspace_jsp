<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd" id="WebApp_ID" version="4.0">
  <display-name>pro08</display-name>
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
    <welcome-file>index.jsp</welcome-file>
    <welcome-file>index.htm</welcome-file>
    <welcome-file>index.xhtml</welcome-file>
    <welcome-file>default.html</welcome-file>
    <welcome-file>default.jsp</welcome-file>
    <welcome-file>default.htm</welcome-file>
    <welcome-file>default.xhtml</welcome-file>
  </welcome-file-list>
  
    <!-- ============================================================
       2. 웹앱(pro08) 전체 공유 변수(ServletContext 초기화 파라미터)
       ============================================================
       - 톰캣이 웹앱을 로딩할 때 ServletContext 객체 1개를 만들고
         아래 값들을 그 객체 안에 이름:값 형태로 보관한다.
       - 모든 서블릿과 JSP가 같은 값을 읽어 쓸 수 있다.
       - 읽기 전용 성격이며, 값을 바꾸려면 web.xml 수정 후 서버 재시작이 필요하다.
       [사용 코드]
       String menu = getServletContext().getInitParameter("menu_member");
       ============================================================ -->
  	<context-param> <!-- 공유 변수 1개를 등록하는 단위 태그. 변수 개수 만큼 반복해서 작성한다 -->
  		<param-name>menu_member</param-name>  <!-- 변수이름. 자바 코드에서 이 문자열로 값을 찾는다. 대소 문자 구분한다. -->
  		<param-value>회원등록 회원조회 회원수정</param-value>	
  		<!-- menu_member변수에 저장할 값. 타입은 무조건 String 하나 뿐이다. -->
  		<!-- 어러 개를 담으려면 위처럼 구분자(공백, 쉼표)로 이어 붙인 뒤 split()으로 잘라 쓴다. -->
  	</context-param>
  	
  	<context-param> <!-- 공유 변수 1개를 등록하는 단위 태그. 변수 개수 만큼 반복해서 작성한다 -->
  		<param-name>menu_order</param-name> <!-- 변수이름. -->
  		<param-value>주문조회 주문등록 주문수정 주문취소</param-value> <!-- menu_order 변수에 저장할 값 설정 -->
  	</context-param>
  
    <context-param>
    	<param-name>menu_goods</param-name> <!-- 변수이름. -->
    	<param-value>상품조회 상품등록 상품수정 상품삭제</param-value> <!-- 한글 값이므로 web.xml이 UTF-8로 저장되어 있어야 깨지지 않는다. -->
    </context-param>
  
  
</web-app>




